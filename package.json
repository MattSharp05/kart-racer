{
  "name": "kart-racer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:perf && pnpm build && pnpm check:bundle && pnpm test:e2e",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots",
    "test:perf": "vitest run -c vitest.perf.config.ts",
    "test:netsoak": "vitest run -c vitest.netsoak.config.ts",
    "test:soak": "playwright test -c playwright.soak.config.ts",
    "net:sweep": "vitest run -c vitest.lab.config.ts --reporter=verbose",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "test:sql": "scripts/test-sql.sh",
    "track-limits": "vitest run -c vitest.lab.config.ts scripts/track-limits.lab.ts --silent=false --reporter=dot"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "lil-gui": "^0.21.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
