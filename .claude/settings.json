{
  "extraKnownMarketplaces": {
    "claude-workflow": {
      "source": { "source": "github", "repo": "MattSharp05/claude-workflow" }
    }
  },
  "enabledPlugins": {
    "workflow@claude-workflow": true
  },
  "permissions": {
    "allow": [
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(git push *)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)",
      "mcp__Notion"
    ]
  }
}
