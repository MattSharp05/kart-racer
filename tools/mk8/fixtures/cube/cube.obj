# MK-93 fixture: a 2 m textured cube with two materials ("road" on top, "wall" on the sides
# and bottom), so the collision export has more than one surface.
mtllib cube.mtl
o cube
v -1 -1 -1
v 1 -1 -1
v 1 1 -1
v -1 1 -1
v -1 -1 1
v 1 -1 1
v 1 1 1
v -1 1 1
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn 0 0 -1
vn 0 0 1
vn -1 0 0
vn 1 0 0
vn 0 1 0
vn 0 -1 0
usemtl wall
f 2/1/1 1/2/1 4/3/1
f 2/1/1 4/3/1 3/4/1
f 5/1/2 6/2/2 7/3/2
f 5/1/2 7/3/2 8/4/2
f 1/1/3 5/2/3 8/3/3
f 1/1/3 8/3/3 4/4/3
f 6/1/4 2/2/4 3/3/4
f 6/1/4 3/3/4 7/4/4
f 1/1/6 2/2/6 6/3/6
f 1/1/6 6/3/6 5/4/6
usemtl road
f 8/1/5 7/2/5 3/3/5
f 8/1/5 3/3/5 4/4/5
